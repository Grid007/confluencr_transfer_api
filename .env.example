NODE_ENV=development
PORT=3000
# Local Docker Compose Postgres
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger
# Optional: separate URL for migrations (Supabase session pooler / direct). Defaults to DATABASE_URL.
# DIRECT_URL=
DB_POOL_MAX=10
# auto | true | false. "auto" disables prepared statements for PgBouncer/Supavisor transaction mode (port 6543).
DB_PREPARE=auto
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
BODY_LIMIT=100kb
